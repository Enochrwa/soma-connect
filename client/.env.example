# ── Client environment variables ───────────────────────────────────────────────
# Copy to .env.local for local dev, set as Vercel env vars in production.

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# WebSocket URL (same host as API, without /api path)
VITE_SOCKET_URL=http://localhost:4000

# pawaPay checkout. Set to "false" to fall back to the manual-transfer flow.
VITE_PAWAPAY_ENABLED=true
