# ── Client environment variables ───────────────────────────────────────────────
# Copy to .env.local for local dev, set as Vercel env vars in production.

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# WebSocket URL (same host as API, without /api path)
VITE_SOCKET_URL=http://localhost:4000

# Payment options are decided by the server (GET /api/payments/config): instant MoMo shows
# only when PAWAPAY_API_TOKEN is set, manual transfer only when a MANUAL_PAY_* number is set.
