# ── Server environment variables ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

NODE_ENV=development
PORT=4000

# MongoDB — use Atlas free tier for production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT — generate strong random secrets (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-64>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-64>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client URL (no trailing slash)
CLIENT_URL=http://localhost:5173
# On production: CLIENT_URL=https://oneafricashop.vercel.app

# Cookie settings
COOKIE_SECURE=false          # set true in production
COOKIE_DOMAIN=               # leave blank for cross-origin (Vercel↔Render)

# Cloudinary (free tier — sign up at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Brevo SMTP (free 300 emails/day — sign up at brevo.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OneAfricaShop <no-reply@soma.rw>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Upstash Redis (optional — for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HuggingFace (optional — for AI search)
HF_API_TOKEN=

# Seed script passwords (optional — random if not set)
SEED_ADMIN_PASSWORD=
SEED_BUYER_PASSWORD=

# ── pawaPay (Merchant API v2) ────────────────────────────────────────────────
# Get a sandbox token from the pawaPay Dashboard → API tokens.
PAWAPAY_ENV=sandbox                            # sandbox | production
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# Shared secret appended to your callback URLs as ?token=...
# Register these EXACT URLs in the pawaPay Dashboard → Developers → Callbacks:
#   Deposits: https://<api-host>/api/payments/pawapay/callback?token=<secret>
#   Payouts:  https://<api-host>/api/payments/pawapay/payouts/callback?token=<secret>
PAWAPAY_CALLBACK_SECRET=

# Re-checks payments whose callback never arrived. Leave enabled.
PAWAPAY_RECONCILE_ENABLED=true
