# ============================================================
# SOMA Market — Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────
# MongoDB Atlas free tier: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# ── Auth / JWT ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Redis (Upstash free tier) ───────────────────────────────
# https://console.upstash.com → free 10,000 cmds/day
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Cloudinary (free 25GB) ──────────────────────────────────
# https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email / SMTP (Gmail free) ───────────────────────────────
# Use a Gmail App Password (not your real password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="SOMA Market <no-reply@somamarket.rw>"

# ── Google OAuth (free) ─────────────────────────────────────
# https://console.cloud.google.com → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your-secret>
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Hugging Face (free AI) ──────────────────────────────────
# https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_<your-token>

# ── Cookie ──────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
